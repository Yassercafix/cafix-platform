# ============================================
# Cafeteria V2 - Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in your values
# DO NOT commit .env.production to version control

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================

# PostgreSQL connection string from Supabase
# Format: postgresql://user:password@host:port/database?sslmode=require
# Get this from Supabase Project Settings > Database > Connection Pooling
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?schema=public&sslmode=require

# ============================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================

# JWT secret for session signing (min 32 characters, use strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-min-32-chars-here

# ============================================
# APPLICATION IDENTITY (REQUIRED)
# ============================================

# Unique application ID for this deployment
VITE_APP_ID=cafeteria-v2-production

# Owner's system ID (usually your user ID or email)
OWNER_OPEN_ID=owner-system-id-here

# OAuth server URL (your authentication backend)
OAUTH_SERVER_URL=https://your-oauth-server.com/api/oauth

# ============================================
# SUPABASE INTEGRATION (OPTIONAL but RECOMMENDED)
# ============================================

# Supabase project URL
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for frontend)
# Get from: Supabase Dashboard > Project Settings > API > anon key
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (keep secret, backend only)
# Get from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# FRONTEND CONFIGURATION (OPTIONAL)
# ============================================

# Frontend API endpoints (if different from backend)
VITE_API_URL=https://your-domain.com/api

# Analytics endpoint (if using analytics)
VITE_ANALYTICS_ENDPOINT=https://your-analytics.com

# ============================================
# DEPLOYMENT NOTES
# ============================================

# For Supabase:
# 1. Create a new project at https://supabase.com
# 2. Go to Project Settings > Database > Connection Pooling
# 3. Copy the connection string and paste as DATABASE_URL
# 4. Replace [PASSWORD] with your database password
# 5. Replace [HOST] with your Supabase host
# 6. Replace [PORT] with your Supabase port (usually 5432 or 6543)

# For JWT_SECRET:
# Generate a strong random string using:
# - Linux/Mac: openssl rand -base64 32
# - Or use: https://generate-random.org/

# For SUPABASE keys:
# 1. Go to Project Settings > API
# 2. Copy "anon key" for SUPABASE_ANON_KEY
# 3. Copy "service_role key" for SUPABASE_SERVICE_ROLE_KEY

# ============================================
# VERIFICATION CHECKLIST
# ============================================

# Before deploying, verify:
# [ ] DATABASE_URL is set and valid
# [ ] JWT_SECRET is at least 32 characters
# [ ] VITE_APP_ID is unique
# [ ] OWNER_OPEN_ID is set
# [ ] OAUTH_SERVER_URL is correct
# [ ] SUPABASE_URL is set
# [ ] SUPABASE_ANON_KEY is set
# [ ] SUPABASE_SERVICE_ROLE_KEY is set

# ============================================
# SECURITY WARNINGS
# ============================================

# ⚠️ NEVER commit .env.production to version control
# ⚠️ NEVER share JWT_SECRET or SUPABASE_SERVICE_ROLE_KEY
# ⚠️ NEVER expose these values in logs or error messages
# ⚠️ Rotate JWT_SECRET periodically
# ⚠️ Use strong, random values for all secrets
